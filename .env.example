# ─────────────────────────────────────────
#  VARIABLES DE ENTORNO — NO subir al repo
#  Copiar como .env y completar los valores
# ─────────────────────────────────────────

# Puerto del servidor (Railway lo asigna automáticamente via PORT)
PORT=3000

# Secreto para firmar los JWT — CAMBIÁ ESTO por una cadena aleatoria larga
# Podés generar una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UNA_CLAVE_SEGURA_Y_LARGA

# Duración del token JWT (7d = 7 días, 1h = 1 hora)
JWT_EXPIRES_IN=7d

# Origen permitido para CORS — tu dominio en producción
# En desarrollo podés dejar * o http://localhost:5500
CORS_ORIGIN=*

# Contraseña del admin por defecto (se crea sola al primer arranque)
# CAMBIALA inmediatamente tras el primer login
ADMIN_DEFAULT_PASS=admin123
